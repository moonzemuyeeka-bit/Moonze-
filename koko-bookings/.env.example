# ---------------------------------------------------------------------------
# Koko's Bookings — environment configuration
# Copy to `.env` and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (local Postgres, Supabase, Neon, RDS — anything Postgres)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/koko_bookings?schema=public"

# Separate database used by `npm test`
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/koko_bookings_test?schema=public"

# Signs the admin session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Verifies payment-provider webhook signatures
PAYMENT_WEBHOOK_SECRET="change-me-too-a-long-random-string"

# Payment provider: "mock" (sandbox, no real money) or a real provider id once
# an integration is added (e.g. "flutterwave", "lenco", "broadpay").
PAYMENT_PROVIDER="mock"

# Shows the sandbox payment simulator and the demo admin hint on the login page.
# MUST be "false" in production.
DEMO_MODE="true"

# Seeded admin account (only used by `npm run db:seed`)
ADMIN_EMAIL="owner@kokosbookings.zm"
ADMIN_PASSWORD="KokoLashes2026!"
ADMIN_NAME="Koko"

# Public site URL, used for metadata / share links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Protects the cron endpoints (reminder dispatch, reservation sweeper)
CRON_SECRET="change-me-cron-secret"
