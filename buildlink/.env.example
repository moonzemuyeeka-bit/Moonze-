# ---------------------------------------------------------------------------
# BuildLink Zambia — environment configuration
#
# Copy to `.env` for local development. NEVER commit a real `.env`.
# Every variable below is validated at boot by src/lib/env.ts, so a missing or
# malformed value fails fast instead of causing a runtime surprise.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Absolute base URL of this deployment. Used for absolute links in contracts,
# notifications and OAuth-style redirects.
APP_URL="http://localhost:3000"

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string.
#   Local:      postgresql://buildlink:password@127.0.0.1:5432/buildlink_dev?schema=public
#   Neon:       postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/buildlink?sslmode=require
#   Supabase:   use the *pooled* (pgbouncer, port 6543) URL for DATABASE_URL and
#               the direct (port 5432) URL for DIRECT_DATABASE_URL.
DATABASE_URL="postgresql://buildlink:buildlink_dev_password@127.0.0.1:5432/buildlink_dev?schema=public"

# Unpooled connection used only by `prisma migrate` and `prisma db push`.
# If your provider has no separate pooler, set it to the same value as
# DATABASE_URL. On Supabase/Neon use the direct (port 5432) connection here and
# the pooled connection above.
DIRECT_DATABASE_URL="postgresql://buildlink:buildlink_dev_password@127.0.0.1:5432/buildlink_dev?schema=public"

# Separate database used by `npm run test:integration`. It is TRUNCATED between
# tests, so never point this at a database you care about.
TEST_DATABASE_URL="postgresql://buildlink:buildlink_dev_password@127.0.0.1:5432/buildlink_test?schema=public"

# --- Authentication ---------------------------------------------------------
# 32+ byte random secret used to sign/derive session material.
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-me-with-openssl-rand-base64-48-at-least-32-chars"

# Session lifetime in days.
SESSION_TTL_DAYS="30"

# bcrypt cost factor. 12 is a sensible production default; lower it to 4 in
# automated tests to keep suites fast.
BCRYPT_COST="12"

# --- Payments ---------------------------------------------------------------
# Which PaymentProvider to load. See src/lib/services/payments/.
#   sandbox      -> deterministic, clearly-labelled test provider (DEV ONLY)
#   mobile_money -> Zambian mobile-money aggregator (requires credentials below)
#   none         -> only offline/recorded payments are offered
PAYMENT_PROVIDER="sandbox"

# Hard safety switch. The sandbox provider refuses to run in production unless
# this is explicitly "true". Leave unset in production.
# ALLOW_SANDBOX_PAYMENTS="false"

# Credentials for a real aggregator. BuildLink ships no default provider: until
# these are set, PAYMENT_PROVIDER=mobile_money fails loudly rather than faking
# a successful payment.
# MOBILE_MONEY_API_BASE_URL=""
# MOBILE_MONEY_API_KEY=""
# MOBILE_MONEY_WEBHOOK_SECRET=""

# --- File storage -----------------------------------------------------------
# StorageProvider driver. See src/lib/services/storage/.
#   local -> writes to ./storage and serves via /api/files (development only)
#   s3    -> any S3-compatible bucket (AWS S3, Supabase Storage, Cloudflare R2)
STORAGE_DRIVER="local"

# STORAGE_S3_BUCKET=""
# STORAGE_S3_REGION="eu-central-1"
# STORAGE_S3_ENDPOINT=""            # omit for AWS, set for R2/Supabase/MinIO
# STORAGE_S3_ACCESS_KEY_ID=""
# STORAGE_S3_SECRET_ACCESS_KEY=""
# STORAGE_S3_PUBLIC_BASE_URL=""     # CDN / public base URL for stored objects

# --- Notifications ----------------------------------------------------------
# In-app notifications always work. Email/SMS/WhatsApp channels stay disabled
# until credentials exist — BuildLink logs instead of pretending to deliver.
NOTIFICATION_EMAIL_DRIVER="log"     # log | smtp
NOTIFICATION_SMS_DRIVER="log"       # log | http
NOTIFICATION_WHATSAPP_DRIVER="log"  # log | http

# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="BuildLink Zambia <no-reply@example.test>"
# SMS_HTTP_ENDPOINT=""
# SMS_HTTP_API_KEY=""
# WHATSAPP_HTTP_ENDPOINT=""
# WHATSAPP_HTTP_API_KEY=""

# --- Analytics --------------------------------------------------------------
# Privacy-conscious product analytics sink: db | log | none
ANALYTICS_DRIVER="db"

# --- AI assistants ----------------------------------------------------------
# Material estimation, budget advice and finish-palette recommendations are
# deterministic rule engines by default and need no API key. Setting an LLM
# provider only enriches the explanatory copy; quantities stay rule-based.
AI_PROVIDER="rules"                 # rules | openai
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# --- Rate limiting ----------------------------------------------------------
# memory -> per-instance token buckets (fine for a single node / development)
# db     -> shared buckets in Postgres (correct across serverless instances)
RATE_LIMIT_DRIVER="db"

# --- Seeding ----------------------------------------------------------------
# Password applied to the clearly-fake demo accounts created by `npm run db:seed`.
# Seeding refuses to run against a production database.
SEED_DEMO_PASSWORD="BuildLinkDemo123!"
