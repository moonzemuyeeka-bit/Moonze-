# ---- Server ----
PORT=3000

# ---- OpenAI (optional) ----
# When set, Moonze uses OpenAI for natural-language understanding + replies.
# When empty, Moonze falls back to a built-in rule-based assistant so the
# whole product still works end-to-end with zero external dependencies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- WhatsApp Cloud API (Meta) ----
# Used by the /webhook/whatsapp endpoint. Leave blank to run in "echo/log"
# mode where outbound messages are logged instead of sent.
WHATSAPP_VERIFY_TOKEN=moonze-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
